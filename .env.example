# Copy this file to .env and replace the values with your local database settings.
# Do not commit the .env file.

DB_URL=jdbc:mysql://localhost:3306/labmonitor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=1209600000
JWT_COOKIE_SECURE=false
FLYWAY_BASELINE_ON_MIGRATE=false
LABMONITOR_TIME_ZONE=Europe/Warsaw
BOOTSTRAP_ADMIN_ENABLED=false
